{
  "info": {
    "_postman_id": "9d3b0b1e-8d89-4c90-9c62-license-management",
    "name": "License Management Service - Complete API Collection",
    "description": "Complete Postman collection for the current License Management Service controllers. Default base URL: http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "licenseId",
      "value": "PUT_CREATED_LICENSE_ID_HERE"
    },
    {
      "key": "licenseKey",
      "value": "PUT_CREATED_LICENSE_KEY_HERE"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "actorId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "assignedBy",
      "value": "22222222-2222-2222-2222-222222222222"
    }
  ],
  "item": [
    {
      "name": "1. License Lifecycle",
      "item": [
        {
          "name": "01 - Create License",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses"
              ]
            },
            "description": "Creates a license. X-Actor-Id is optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlan\": \"PREMIUM\",\n  \"licenseType\": \"SUBSCRIPTION\",\n  \"activationDate\": \"2026-09-09\",\n  \"expiryDate\": \"2027-09-09\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 - Get All Licenses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses"
              ]
            },
            "description": "Returns all licenses."
          }
        },
        {
          "name": "03 - Get Licenses By Plan And Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses?plan=PREMIUM&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses"
              ],
              "query": [
                {
                  "key": "plan",
                  "value": "PREMIUM"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            },
            "description": "Filters using optional plan and status query parameters."
          }
        },
        {
          "name": "04 - Get License By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "05 - Get License By Key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/key/{{licenseKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "key",
                "{{licenseKey}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "06 - Update License",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}"
              ]
            },
            "description": "Updates license plan/type/dates. X-Actor-Id is optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlan\": \"STANDARD\",\n  \"licenseType\": \"SUBSCRIPTION\",\n  \"activationDate\": \"2026-09-09\",\n  \"expiryDate\": \"2027-03-08\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. License Status Operations",
      "item": [
        {
          "name": "07 - Activate License",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "activate"
              ]
            },
            "description": "Activates a valid PENDING license."
          }
        },
        {
          "name": "08 - Suspend License",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "suspend"
              ]
            },
            "description": "Suspends a valid ACTIVE license."
          }
        },
        {
          "name": "09 - Reactivate License",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/reactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "reactivate"
              ]
            },
            "description": "Reactivates a valid SUSPENDED license that has not expired."
          }
        },
        {
          "name": "10 - Renew License",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/renew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "renew"
              ]
            },
            "description": "Renews the license. New expiry must be later than current expiry.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newExpiryDate\": \"2027-12-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11 - Get License Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "status"
              ]
            },
            "description": "Returns status and computed expired flag."
          }
        }
      ]
    },
    {
      "name": "3. License Assignment",
      "item": [
        {
          "name": "12 - Assign License To Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "assign"
              ]
            },
            "description": "Assigns the license to a tenant. Both UUID fields are required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"assignedBy\": \"{{assignedBy}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "13 - Revoke License Assignment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Actor-Id",
                "value": "{{actorId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/licenses/{{licenseId}}/assign/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "licenses",
                "{{licenseId}}",
                "assign",
                "{{tenantId}}"
              ]
            },
            "description": "Revokes the assignment. X-Actor-Id is optional."
          }
        }
      ]
    }
  ]
}